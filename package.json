{
  "name": "tidy",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/build-ocr.mjs && vite",
    "build": "npm run build:mac",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke-test.mjs",
    "build:app": "node scripts/build-ocr.mjs && vite build",
    "build:mac": "node scripts/build-ocr.mjs --arm64 && vite build && node scripts/prepare-mac.mjs && electron-builder --mac dmg --arm64",
    "build:mac:release": "node scripts/mac-release.mjs",
    "test:files": "node scripts/file-tests.mjs",
    "test:desktop": "node scripts/desktop-test.mjs",
    "test:schedule": "node scripts/schedule-test.mjs",
    "test:a11y": "node scripts/audit.mjs",
    "test:subfolders": "node scripts/subfolder-tests.mjs",
    "test:subfolders:desktop": "node scripts/subfolder-desktop-test.mjs",
    "test:source-choices": "node scripts/source-choices-desktop-test.mjs",
    "test:key": "node scripts/key-test.mjs",
    "test:ai": "node scripts/ai-test.mjs",
    "test:preview": "node scripts/preview-test.mjs",
    "test:mac-features": "node scripts/mac-features-test.mjs",
    "test:discovery": "node scripts/discovery-test.mjs"
  },
  "build": {
    "appId": "com.ericauzenne.tidy",
    "productName": "Tidy",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release/macos",
      "app": "build/mac-app"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/tidy-ocr",
      "!**/._*",
      "!node_modules/**/*"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ]
    },
    "npmRebuild": false,
    "asarUnpack": [
      "build/tidy-ocr"
    ]
  },
  "devDependencies": {
    "@google/genai": "^1.43.0",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-select": "2.1.6",
    "@radix-ui/react-switch": "1.1.3",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^25.3.3",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "^4.14.0",
    "clsx": "^2.1.1",
    "date-fns": "3.6.0",
    "dotenv": "^17.3.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.8.1",
    "motion": "12.23.24",
    "next-themes": "0.4.6",
    "node-schedule": "^2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.1.12",
    "tw-animate-css": "1.3.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-electron": "^0.29.0",
    "@bradleyhodges/sfsymbols": "^7.0.4",
    "@bradleyhodges/sfsymbols-react": "^7.0.4",
    "@bradleyhodges/sfsymbols-types": "^7.0.4"
  },
  "description": "File organization with preview, reversible moves, and AI-assisted rules.",
  "author": "Eric Auzenne"
}
